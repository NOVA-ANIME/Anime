{name:"Parasyte",cat:"رعب",img:p("https://cdn.myanimelist.net/images/anime/9/67876.jpg")},
{name:"Hell's Paradise",cat:"رعب",img:p("https://cdn.myanimelist.net/images/anime/1410/136158.jpg")},
{name:"Higurashi",cat:"رعب",img:p("https://cdn.myanimelist.net/images/anime/6/78100.jpg")},
{name:"Shiki",cat:"رعب",img:p("https://cdn.myanimelist.net/images/anime/12/52061.jpg")},
{name:"Elfen Lied",cat:"رعب",img:p("https://cdn.myanimelist.net/images/anime/4/19644.jpg")},

// مغامرات
{name:"Frieren",cat:"مغامرات",img:p("https://cdn.myanimelist.net/images/anime/1127/142324.jpg")},
{name:"Vinland Saga",cat:"مغامرات",img:p("https://cdn.myanimelist.net/images/anime/1500/103360.jpg")},
{name:"Fullmetal Alchemist",cat:"مغامرات",img:p("https://cdn.myanimelist.net/images/anime/1223/96541.jpg")},
{name:"Dr. Stone",cat:"مغامرات",img:p("https://cdn.myanimelist.net/images/anime/5/82448.jpg")},
{name:"Made in Abyss",cat:"مغامرات",img:p("https://cdn.myanimelist.net/images/anime/6/86733.jpg")},

// كوميديا
{name:"Spy x Family",cat:"كوميديا",img:p("https://cdn.myanimelist.net/images/anime/1441/122795.jpg")},
{name:"Gintama",cat:"كوميديا",img:p("https://cdn.myanimelist.net/images/anime/3/72078.jpg")},
{name:"Konosuba",cat:"كوميديا",img:p("https://cdn.myanimelist.net/images/anime/8/78761.jpg")},
{name:"One Punch Man",cat:"كوميديا",img:p("https://cdn.myanimelist.net/images/anime/12/76049.jpg")},
{name:"Mashle",cat:"كوميديا",img:p("https://cdn.myanimelist.net/images/anime/1498/134443.jpg")},
];
const cats=["الكل","اكشن","غموض","ايسيكاي","شونين","رعب","مغامرات","كوميديا"];
let cur="الكل";
function drawCats(){document.getElementById('cats').innerHTML=cats.map(c=>`<button class="${c===cur?'active':''}" onclick="cur='${c}';drawCats();draw()">${c}</button>`).join('')}
function draw(){let list=animes.filter(a=>cur==="الكل"||a.cat===cur);document.getElementById('grid').innerHTML=list.map((a,i)=>`<div class="card"><div class="num">#${String(i+1).padStart(2,'0')}</div><img src="${a.img}" loading="lazy"><div class="info"><h3>${a.name}</h3><span class="cat">${a.cat}</span></div></div>`).join('')}
drawCats();draw();
</script>
</body>
</html>
