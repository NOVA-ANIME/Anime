<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>NOVA ANIME</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Cairo',sans-serif}
body{background:#060606;color:#fff}
header{background:#000;padding:14px 5%;display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid #fff;position:sticky;top:0;z-index:999}
.logo{font-size:30px;font-weight:900}.logo span{background:#fff;color:#000;padding:2px 12px;border-radius:8px}
.cats{display:flex;gap:8px;padding:12px 5%;overflow-x:auto;background:#0f0f0f;position:sticky;top:66px;z-index:998}
.cats::-webkit-scrollbar{display:none}
.cats button{border:1px solid #333;background:#1a1a1a;color:#fff;padding:8px 18px;border-radius:30px;font-weight:700;cursor:pointer;white-space:nowrap}
.cats button.active{background:#fff;color:#000}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;padding:20px 5%}
.card{position:relative;background:#111;border-radius:16px;overflow:hidden;border:1px solid #222}
.card img{width:100%;height:250px;object-fit:cover;display:block}
.card .num{position:absolute;top:8px;left:8px;background:#fff;color:#000;font-weight:900;padding:2px 10px;border-radius:20px;font-size:12px}
.card .info{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.95));padding:35px 10px 10px}
.card h3{font-size:12px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cat{font-size:10px;background:#fff;color:#000;padding:2px 8px;border-radius:10px;font-weight:700}
</style>
</head>
<body>
<header><div style="font-size:12px;opacity:.6">NOVA</div><div class="logo">NOVA<span>ANIME</span></div></header>
<div class="cats" id="cats"></div>
<div class="grid" id="grid"></div>
<script>
const p=u=>`https://wsrv.nl/?url=${encodeURIComponent(u)}&w=400&h=600&fit=cover&output=webp`;
const animes=[
// اكشن
{name:"Attack on Titan",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/10/47347.jpg")},
{name:"Jujutsu Kaisen",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/1171/109222.jpg")},
{name:"Demon Slayer",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/1286/99889.jpg")},
{name:"Solo Leveling",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/1929/144919.jpg")},
{name:"Chainsaw Man",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/1806/126216.jpg")},
{name:"One Punch Man",cat:"اكشن",img:p("https://cdn.myanimelist.net/images/anime/12/76049.jpg")},

// غموض
{name:"Monster",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/3/73227.jpg")},
{name:"Death Note",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/9/9453.jpg")},
{name:"Steins;Gate",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/5/73199.jpg")},
{name:"Erased",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/10/78745.jpg")},
{name:"The Promised Neverland",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/5/97746.jpg")},
{name:"Odd Taxi",cat:"غموض",img:p("https://cdn.myanimelist.net/images/anime/1143/117444.jpg")},

// ايسيكاي
{name:"Re:Zero",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/1522/128039.jpg")},
{name:"Mushoku Tensei",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/1028/117777.jpg")},
{name:"Overlord",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/4/72270.jpg")},
{name:"No Game No Life",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/5/65187.jpg")},
{name:"That Time Slime",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/13/83931.jpg")},
{name:"Shield Hero",cat:"ايسيكاي",img:p("https://cdn.myanimelist.net/images/anime/3/81982.jpg")},

// شونين
{name:"One Piece",cat:"شونين",img:p("https://cdn.myanimelist.net/images/anime/1244/138851.jpg")},
{name:"Naruto",cat:"شونين",img:p("https://cdn.myanimelist.net/images/anime/13/17405.jpg")},
{name:"Bleach",cat:"شونين",img:p("https://cdn.myanimelist.net/images/anime/3/40451.jpg")},
{name:"Hunter x Hunter",cat:"شونين",img:p("https://cdn.myanimelist.net/images/anime/1337/99013.jpg")},
{name:"Black Clover",cat:"شونين",img:p("https://cdn.myanimelist.net/images/anime/2/88336.jpg")},
